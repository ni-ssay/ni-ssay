{
  "manifest_version": 3,
  "name": "FlowScribe Recorder",
  "version": "0.1.0",
  "description": "Record browser flows (clicks, typing, hovers, drags, uploads) in your own logged-in browser, with click highlights and screenshots. Export as a FlowScribe session.",
  "permissions": ["storage", "tabs", "webNavigation", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlowScribe Recorder"
  }
}
